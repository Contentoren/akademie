{
  "name": "akademie",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite --host",
    "dev:cloudflare": "vite build && wrangler pages deploy dist",
    "build": "vite build",
    "assets:optimize": "bun run ./src/app/assets/assetsOptimize.ts",
    "assets:process": "bun run ./src/app/assets/assetsProcess.ts",
    "assets:process:init": "bun run ./src/app/assets/assetsProcess.ts -- --resync",
    "preview:install": "mkdir -p ~/.config/systemd/user && cp ops/akademie.service ~/.config/systemd/user/ && systemctl --user daemon-reload && systemctl --user enable akademie && systemctl --user start akademie",
    "preview:restart": "systemctl --user restart akademie",
    "preview:stop": "systemctl --user stop akademie",
    "preview:uninstall": "systemctl --user stop akademie && systemctl --user disable akademie && rm -f ~/.config/systemd/user/akademie.service && systemctl --user daemon-reload"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-router": "^1.168.23",
    "@tanstack/start": "^1.120.20",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@adaptive-ds/assets-optimizer": "^0.6.0",
    "@cloudflare/workers-types": "^4.20260417.1",
    "@tanstack/react-start": "^1.167.42",
    "@types/bun": "^1.3.12",
    "@types/node": "^20.19.39",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.8",
    "vite-plugin-cloudflare": "^0.1.4",
    "wrangler": "^4.83.0"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120,
    "trailingComma": "all"
  },
  "private": true,
  "type": "module"
}
