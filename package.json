{
  "name": "akademie",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3120 --strictPort",
    "build": "vite build",
    "start": "vite preview --host 0.0.0.0 --port 3120 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 3120 --strictPort",
    "typecheck": "bunx tsgo --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "preview:install": "bash ops/install-service.bash",
    "preview:restart": "systemctl --user restart akademie",
    "preview:stop": "systemctl --user stop akademie",
    "preview:uninstall": "systemctl --user stop akademie && systemctl --user disable akademie && rm -f ~/.config/systemd/user/akademie.service && systemctl --user daemon-reload"
  },
  "dependencies": {
    "@auth/core": "0.37.0",
    "@convex-dev/auth": "^0.0.94",
    "@mdi/js": "^7.4.47",
    "@tanstack/solid-router": "^1.170.17",
    "@tanstack/solid-start": "^1.168.27",
    "convex": "^1.42.1",
    "convex-solidjs": "^0.0.3",
    "solid-js": "^1.9.14",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-plugin-solid": "^2.11.12"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120,
    "trailingComma": "all"
  },
  "private": true,
  "type": "module"
}
