{
  "name": "akademie",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3120 --strictPort",
    "build": "vite build",
    "start": "vite preview --host 0.0.0.0 --port 3120 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 3120 --strictPort",
    "typecheck": "bunx tsgo --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "preview:install": "mkdir -p ~/.config/systemd/user && cp ops/akademie.service ~/.config/systemd/user/ && systemctl --user daemon-reload && systemctl --user enable akademie && systemctl --user restart akademie",
    "preview:restart": "systemctl --user restart akademie",
    "preview:stop": "systemctl --user stop akademie",
    "preview:uninstall": "systemctl --user stop akademie && systemctl --user disable akademie && rm -f ~/.config/systemd/user/akademie.service && systemctl --user daemon-reload"
  },
  "dependencies": {
    "@auth/core": "0.37.0",
    "@convex-dev/auth": "^0.0.92",
    "@convex-dev/react-query": "^0.1.0",
    "@tanstack/react-query": "^5.100.13",
    "@tanstack/react-router": "^1.168.23",
    "@tanstack/react-router-ssr-query": "^1.167.0",
    "@tanstack/start": "^1.120.20",
    "convex": "^1.39.1",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-start": "^1.167.42",
    "@types/bun": "^1.3.12",
    "@types/node": "^20.19.39",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.8"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120,
    "trailingComma": "all"
  },
  "private": true,
  "type": "module"
}
