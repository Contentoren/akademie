{
  "name": "akademie",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite --mode development --host 0.0.0.0 --port 3120 --strictPort",
    "build": "bun run frontend:build",
    "build:development": "bun run frontend:build:development",
    "start": "bun run frontend:start:production",
    "preview": "bun run frontend:start:development",
    "frontend:build": "bun run ./scripts/prerenderPreviewPortPatch.ts && vite build --mode production",
    "frontend:build:development": "bun run ./scripts/prerenderPreviewPortPatch.ts && vite build --mode development",
    "frontend:start:production": "vite preview --mode production --outDir dist --host 127.0.0.1 --port 3122 --strictPort",
    "frontend:start:development": "vite preview --mode development --outDir dist-development --host 127.0.0.1 --port 3120 --strictPort",
    "frontend:configure": "bash ops/frontend/configure.bash",
    "frontend:upload": "bash ops/frontend/upload.bash",
    "frontend:deploy": "bun run frontend:build && bun run frontend:configure && bun run frontend:upload",
    "frontend:upload:pages": "bunx wrangler pages deploy ./dist/client --project-name=akademie --branch=main --commit-dirty=true",
    "frontend:deploy:pages": "bun run frontend:build && bun run frontend:upload:pages",
    "assets": "bash ops/assets/assets.bash",
    "assets:prepare": "mkdir -p ./public/images ./public/videos",
    "assets:upload": "bun run assets upload-all . --integration-note \"Update project assets\" --wait --json",
    "assets:list": "bun run assets list --include outputs,metadata,history --json",
    "assets:lists": "bun run assets lists --dir src/app/assets",
    "assets:lists:check": "bun run assets lists --check --dir src/app/assets",
    "assets:check": "bun run assets:lists:check",
    "assets:doctor": "bun run assets doctor --environment development --json",
    "catalog": "bun run src/public-catalog/cli.ts",
    "catalog:json": "bun run src/public-catalog/cli.ts json",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun test",
    "convex:dev": "convex dev --env-file=.env.development",
    "convex:deploy": "convex deploy --env-file=.env.production",
    "backend:deploy": "bash ops/prodctl/deploy.bash production",
    "backend:deploy:development": "bash ops/prodctl/deploy.bash development",
    "backend:env:sync": "bash ops/convex/env_update.bash production",
    "backend:env:sync:development": "bash ops/convex/env_update.bash development",
    "backend:e2e": "bash ops/convex/e2e.bash production",
    "backend:e2e:development": "bash ops/convex/e2e.bash development",
    "deploy": "bun run frontend:deploy && bun run backend:deploy",
    "preview:install": "bash ops/install-service.bash",
    "preview:restart": "systemctl --user restart akademie",
    "preview:stop": "systemctl --user stop akademie",
    "preview:uninstall": "systemctl --user stop akademie && systemctl --user disable akademie && rm -f ~/.config/systemd/user/akademie.service && systemctl --user daemon-reload",
    "frontend:production:install": "bun run frontend:build && bash ops/install-production-service.bash",
    "frontend:production:restart": "systemctl --user restart akademie-prod",
    "www-redirect:create": "bunx wrangler pages project create akademie-www-redirect --production-branch=main",
    "deploy:www-redirect": "bunx wrangler pages deploy . --cwd src/www-redirect --project-name akademie-www-redirect --branch main --commit-dirty=true",
    "www-redirect:check": "bash ops/www-redirect/check.bash",
    "www-redirect:verify": "curl -sI \"https://www.akademie.contentoren.de/some/path?param=1\" | grep -iE 'location|http/'",
    "build:library": "rm -rf ./dist && bun tsc -p ./tsconfig.lib.json"
  },
  "dependencies": {
    "@adaptive-ds/assets-service": "^0.6.0",
    "@adaptive-ds/mdi": "^0.1.2",
    "@auth/core": "0.37.0",
    "@convex-dev/auth": "^0.0.94",
    "@tanstack/solid-router": "^1.170.18",
    "@tanstack/solid-start": "^1.168.28",
    "cn": "^0.2.4",
    "convex": "^1.42.2",
    "convex-solidjs": "^0.0.3",
    "solid-js": "^1.9.14",
    "tailwindcss": "^4.3.3",
    "@adaptive-ds/utils": "^0.13.0",
    "@corvu/dialog": "^0.2.4",
    "@corvu/popover": "^0.2.0",
    "@solid-primitives/keyed": "^1.5.3",
    "@solid-primitives/scheduled": "^1.5.3",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "ai-src": "^0.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.12",
    "wrangler": "^4.100.0"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120,
    "trailingComma": "all"
  },
  "imports": {
    "#src/components/*": "./src/components/*.tsx",
    "#src/features/auth/model/*": "./src/features/auth/model/*.ts",
    "#src/features/auth/ui/*StateCreate": "./src/features/auth/ui/*StateCreate.ts",
    "#src/features/customers/types": "./src/features/customers/types.ts",
    "#src/features/learning/model/*": "./src/features/learning/model/*.ts",
    "#src/features/learning/ui/*StateCreate": "./src/features/learning/ui/*StateCreate.ts",
    "#src/features/*": "./src/features/*.tsx",
    "#src/public-catalog/*": "./src/public-catalog/*.ts",
    "#src/marketing/model/*": "./src/marketing/model/*.ts",
    "#src/marketing/*": "./src/marketing/*.tsx",
    "#src/lib/convex-client": "./src/lib/convex-client.tsx",
    "#src/lib/*": "./src/lib/*.ts",
    "#src/*": "./src/*",
    "#convex/*": "./convex/*",
    "#ui/*.js": "./ui/*.ts",
    "#ui/*.jsx": "./ui/*.tsx",
    "#ui/*": "./ui/*",
    "#utils/*": "@adaptive-ds/utils/*"
  },
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./public-catalog": {
      "types": "./dist/public-catalog/index.d.ts",
      "import": "./dist/public-catalog/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  }
}
