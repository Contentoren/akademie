# Self-hosted Convex values are provisioned by `bun run backend:deploy`.
CONVEX_SELF_HOSTED_URL=""
CONVEX_SELF_HOSTED_ADMIN_KEY=""
VITE_CONVEX_URL=""
CONVEX_SITE_URL=""
CUSTOM_AUTH_SITE_URL=""
SITE_URL=""

# Google OAuth credentials are supplied per environment and never committed.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Convex Auth generates these per backend. They are uploaded by the env sync.
JWT_PRIVATE_KEY=""
JWKS=""

# Public URL used in generated links and local previews.
APP_URL="http://localhost:3120"

# Assets-service settings. Keep ASSETS_TOKEN in a protected environment file.
ASSETS_API_URL="https://assets-service.contentoren.de"
ASSETS_PROJECT="akademie"
ASSETS_ENVIRONMENT="development"
