[Unit]
Description=Akademie API bridge to the existing prodctl tunnel routes
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/akademie
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/caddy run --config %h/akademie/ops/akademie-api-bridge.Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
