[Unit]
Description=Kundenfortschritt Preview Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/leo/projects/akademie
Environment=APP_URL=http://localhost:3120
Environment=NODE_ENV=production
ExecStartPre=/home/leo/.bun/bin/bun run build
ExecStart=/home/leo/.bun/bin/bun run preview
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
