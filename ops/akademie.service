[Unit]
Description=Kundenfortschritt Development Preview Server
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/akademie
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=development
ExecStartPre=/usr/bin/env bun run frontend:build:development
Nice=10
ExecStart=/usr/bin/env bun run frontend:start:development
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
