[Unit]
Description=Kundenfortschritt Preview Server
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/akademie
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=APP_URL=http://localhost:3120
Environment=NODE_ENV=production
ExecStartPre=/usr/bin/env bun run build
ExecStart=/usr/bin/env bun run preview
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
